# Each job appends its output to /var/log/dtcdn/cron-<name>.log (a dtcdn-owned 0750 directory made by install.sh;
# rotated by install/dtcdn-logrotate). Not the repo's logs/, which is world-writable: a symlink planted there would
# make the cron append to any file dtcdn can write. Without the redirect the output went to cron's mail, where the
# upload queue's "Failed files" went unread.

# Updates 30s bandwidth from Redis
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/update-30s-bw.php >> /var/log/dtcdn/cron-update-30s-bw.log 2>&1

# Maintains running total of bandwidth
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/add-bw-chunk.php >> /var/log/dtcdn/cron-add-bw-chunk.log 2>&1

# Cloud uploads
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/cloud-upload-queue.php >> /var/log/dtcdn/cron-cloud-upload-queue.log 2>&1

# Second cron
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/second.php >> /var/log/dtcdn/cron-second.log 2>&1

# Minute cron: disk space, expired jobs, the transcoding sweep
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/minute.php >> /var/log/dtcdn/cron-minute.log 2>&1

# Figures out what files we need to retrieve
* * * * * dtcdn /usr/bin/php7.4 /home/dtcdn/cron/handle-404s.php >> /var/log/dtcdn/cron-handle-404s.log 2>&1

# Prune old stopped containers this install started (the label set by scripts/docker-ffmpeg.sh and docker-ffprobe.sh;
# the timestamp is relative to when the container was started). As root: the dtcdn user isn't in the docker group,
# and until 2026-10 this line ran as dtcdn and had never pruned anything.
11 * * * * root docker container prune --filter "until=48h" --filter "label=dtcdn.managed=1" -f >> /var/log/dtcdn-docker-prune.log 2>&1
