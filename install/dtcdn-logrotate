# /etc/logrotate.d/dtcdn: the cron logs (install/dtcdn-cron) and Logger's fallback files in /home/dtcdn/logs
/home/dtcdn/logs/*.log /home/dtcdn/logs/*.html {
	weekly
	rotate 4
	compress
	delaycompress
	missingok
	notifempty
	su dtcdn dtcdn
	# both the dtcdn crons and Apache (Logger's fallback files) append here; dtcdn is in the www-data group
	create 0664 dtcdn www-data
}
